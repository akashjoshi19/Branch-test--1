# Firebase Configuration
REACT_APP_FIREBASE_API_KEY=your_firebase_api_key
REACT_APP_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your_project_id
REACT_APP_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=123456789
REACT_APP_FIREBASE_APP_ID=1:123456789:web:your_app_id

# Google Drive API Configuration  
REACT_APP_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
REACT_APP_GOOGLE_API_KEY=your_google_api_key

# Instructions:
# 1. Copy this file to .env.local
# 2. Replace the placeholder values with your actual Firebase and Google API credentials
# 3. The application will work in demo mode with mock data if these are not configured